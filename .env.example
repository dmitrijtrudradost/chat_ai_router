# proxy | openai | anthropic | deepseek
PROVIDER=proxy

# ProxyAPI: https://proxyapi.ru/docs
# Адрес единого API. Ключ из кабинета ProxyAPI, не ключ вендора.
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
PROXYAPI_MODEL=openai/gpt-5-mini

# Режим при старте: chat — обычная модель, think — думающая.
CHAT_MODE=chat
# Пусто — берётся модель провайдера (PROXYAPI_MODEL и аналоги).
CHAT_MODEL=
# Пусто — в режиме think используется та же модель, что и в обычном.
THINKING_MODEL=

# Ход рассуждений для режима think. Пусто — параметр не отправляется.
# Значения ProxyAPI: minimal, low, medium, high.
# Модель без рассуждений может вернуть 400 — тогда очистите поле.
REASONING_EFFORT=medium

# Прямые подключения, если PROVIDER не proxy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Бюджет токенов thinking. Пусто — thinking не включается.
# max_tokens ответа должен быть больше этого бюджета.
ANTHROPIC_THINKING_BUDGET=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
